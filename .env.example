# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC for compete-session cookies (required for /events/.../compete)
HACKATHON_COMPETE_SECRET=

# Optional platform bootstrap
PLATFORM_ADMIN_EMAILS=
SAAS_OWNER_EMAILS=
SAAS_OWNER_PASSWORD_1=
SAAS_OWNER_PASSWORD_2=

# ---------------------------------------------------------------------------
# Platform email (Resend) — SaaS / admin / system lanes only
# Docs: docs/email-platform-setup.md
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Default/fallback From only (not the only From). Prefer lane aliases below.
RESEND_FROM_EMAIL=info@aroxes.com
RESEND_REPLY_TO=info@aroxes.com
RESEND_ARCHIVE_BCC=info@aroxes.com
# Optional per-lane From overrides (defaults match @aroxes.com aliases)
# RESEND_FROM_NOTIFICATIONS=notifications@aroxes.com
# RESEND_FROM_EVENTS=events@aroxes.com
# RESEND_FROM_BILLING=billing@aroxes.com
# RESEND_FROM_ONBOARDING=welcome@aroxes.com
# RESEND_FROM_SUPPORT=support@aroxes.com
# RESEND_FROM_SECURITY=security@aroxes.com

# Legacy Brevo fallback (only used when RESEND_API_KEY is missing)
BREVO_API_KEY=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Organizer email connections (Google OAuth / SMTP) — attendee/cert/bulk
# ---------------------------------------------------------------------------
# Min 16 chars; used to encrypt OAuth tokens and SMTP passwords at rest
EMAIL_CONNECTION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-domain.com/api/email/google/callback
GOOGLE_REDIRECT_URI=

# Google Auth for signup/signin is configured in the Supabase dashboard
# (Authentication → Providers → Google). Redirect URL: /auth/callback
# See docs/onboarding-plans-checkout.md

# ---------------------------------------------------------------------------
# Cron jobs (Bearer or ?secret=)
# ---------------------------------------------------------------------------
# Protects GET/POST /api/cron/plan-expiry (5-day plan expiry reminders)
CRON_SECRET=

# Optional product integrations
AI_API_KEY=
AI_URL=

# Organizer feedback analysis (server-only; never expose to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Contact form — Cloudflare Turnstile (optional)
# When SECRET is unset, captcha verification is skipped. Widget only renders
# when the public site key is set.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
